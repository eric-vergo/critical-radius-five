    margin=20;
    "lemma:normal-form" [shape=box, style="rounded,filled", color="#c2410c", fillcolor="#ffffff", penwidth=1.4, margin="0.10,0.07", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#e2e8f0" WIDTH="214"><TR><TD ALIGN="LEFT" VALIGN="BOTTOM" WIDTH="100"><FONT FACE="Avenir Next Demi-Bold" POINT-SIZE="10" COLOR="#c2410c">LEMMA 3.1</FONT></TD><TD ALIGN="RIGHT" VALIGN="BOTTOM" WIDTH="114"><FONT FACE="Menlo" POINT-SIZE="8" COLOR="#94a3b8">lemma:normal-form</FONT></TD></TR><HR/><TR><TD COLSPAN="2" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Avenir Next Demi-Bold" POINT-SIZE="15" COLOR="#0f172a">Normal form</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Menlo" POINT-SIZE="10" COLOR="#9a3412">mapsTo_reach_left<BR/>mapsTo_reach_right</FONT></TD></TR></TABLE>>];
    "lemma:typed-walk" [shape=box, style="rounded,filled", color="#c2410c", fillcolor="#ffffff", penwidth=1.4, margin="0.10,0.07", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#e2e8f0" WIDTH="214"><TR><TD ALIGN="LEFT" VALIGN="BOTTOM" WIDTH="100"><FONT FACE="Avenir Next Demi-Bold" POINT-SIZE="10" COLOR="#c2410c">LEMMA 3.2</FONT></TD><TD ALIGN="RIGHT" VALIGN="BOTTOM" WIDTH="114"><FONT FACE="Menlo" POINT-SIZE="8" COLOR="#94a3b8">lemma:typed-walk</FONT></TD></TR><HR/><TR><TD COLSPAN="2" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Avenir Next Demi-Bold" POINT-SIZE="15" COLOR="#0f172a">The pivot performs a typed<BR/>walk</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Menlo" POINT-SIZE="10" COLOR="#9a3412">orbit_subset_reach</FONT></TD></TR></TABLE>>];
    "def:level" [shape=box, style="filled", color="#c2410c", fillcolor="#ffffff", penwidth=1.4, margin="0.10,0.07", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#e2e8f0" WIDTH="214"><TR><TD ALIGN="LEFT" VALIGN="BOTTOM" WIDTH="100"><FONT FACE="Avenir Next Demi-Bold" POINT-SIZE="10" COLOR="#c2410c">DEFINITION 3.3</FONT></TD><TD ALIGN="RIGHT" VALIGN="BOTTOM" WIDTH="114"><FONT FACE="Menlo" POINT-SIZE="8" COLOR="#94a3b8">def:level</FONT></TD></TR><HR/><TR><TD COLSPAN="2" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Avenir Next Demi-Bold" POINT-SIZE="15" COLOR="#0f172a">The level</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Menlo" POINT-SIZE="10" COLOR="#9a3412">cutU<BR/>psi<BR/>level</FONT></TD></TR></TABLE>>];
    "lemma:step-table" [shape=box, style="rounded,filled", color="#c2410c", fillcolor="#ffffff", penwidth=1.4, margin="0.10,0.07", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#e2e8f0" WIDTH="214"><TR><TD ALIGN="LEFT" VALIGN="BOTTOM" WIDTH="100"><FONT FACE="Avenir Next Demi-Bold" POINT-SIZE="10" COLOR="#c2410c">LEMMA 3.4</FONT></TD><TD ALIGN="RIGHT" VALIGN="BOTTOM" WIDTH="114"><FONT FACE="Menlo" POINT-SIZE="8" COLOR="#94a3b8">lemma:step-table</FONT></TD></TR><HR/><TR><TD COLSPAN="2" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Avenir Next Demi-Bold" POINT-SIZE="15" COLOR="#0f172a">The step table</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Menlo" POINT-SIZE="10" COLOR="#9a3412">level_of_mem_units<BR/>psi_of_level_eq_three<BR/>level_emod_five</FONT></TD></TR></TABLE>>];
    "lemma:active-step" [shape=box, style="rounded,filled", color="#c2410c", fillcolor="#ffffff", penwidth=1.4, margin="0.10,0.07", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#e2e8f0" WIDTH="214"><TR><TD ALIGN="LEFT" VALIGN="BOTTOM" WIDTH="100"><FONT FACE="Avenir Next Demi-Bold" POINT-SIZE="10" COLOR="#c2410c">LEMMA 3.5</FONT></TD><TD ALIGN="RIGHT" VALIGN="BOTTOM" WIDTH="114"><FONT FACE="Menlo" POINT-SIZE="8" COLOR="#94a3b8">lemma:active-step</FONT></TD></TR><HR/><TR><TD COLSPAN="2" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Avenir Next Demi-Bold" POINT-SIZE="15" COLOR="#0f172a">Only active steps break a<BR/>level bound</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Menlo" POINT-SIZE="10" COLOR="#9a3412">level_mem_band<BR/>level_ne_of_isCutLevel</FONT></TD></TR></TABLE>>];
