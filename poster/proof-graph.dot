digraph proof {
  rankdir=BT;
  bgcolor="transparent";
  newrank=true;
  nodesep=0.30;
  ranksep=0.95;
  splines=spline;
  outputorder="edgesfirst";
  fontname="Avenir Next";
  node [fontname="Avenir Next"];
  edge [penwidth=1.5, arrowsize=0.8, arrowhead=vee];
  subgraph "cluster_upper-bound" {
    label=<<FONT FACE="Avenir Next Demi-Bold" POINT-SIZE="21" COLOR="#1d4ed8">Upper bound:  r<SUB><FONT POINT-SIZE="14">c</FONT></SUB>(5) ≤ √(3 + φ)</FONT>>;
    labeljust="l"; labelloc="b";
    style="rounded,filled"; fillcolor="#eff6ff"; color="#93c5fd"; penwidth=1.5;
    margin=20;
    "def:points" [shape=box, style="filled", color="#1d4ed8", fillcolor="#ffffff", penwidth=1.4, margin="0.10,0.07", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#e2e8f0" WIDTH="214"><TR><TD ALIGN="LEFT" VALIGN="BOTTOM" WIDTH="100"><FONT FACE="Avenir Next Demi-Bold" POINT-SIZE="10" COLOR="#1d4ed8">DEFINITION 2.1</FONT></TD><TD ALIGN="RIGHT" VALIGN="BOTTOM" WIDTH="114"><FONT FACE="Menlo" POINT-SIZE="8" COLOR="#94a3b8">def:points</FONT></TD></TR><HR/><TR><TD COLSPAN="2" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Avenir Next Demi-Bold" POINT-SIZE="15" COLOR="#0f172a">The chord E′E</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Menlo" POINT-SIZE="10" COLOR="#1e40af">chordE<BR/>smul_chordE</FONT></TD></TR></TABLE>>];
    "lemma:convex-words" [shape=box, style="rounded,filled", color="#1d4ed8", fillcolor="#ffffff", penwidth=1.4, margin="0.10,0.07", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#e2e8f0" WIDTH="214"><TR><TD ALIGN="LEFT" VALIGN="BOTTOM" WIDTH="100"><FONT FACE="Avenir Next Demi-Bold" POINT-SIZE="10" COLOR="#1d4ed8">LEMMA 2.2</FONT></TD><TD ALIGN="RIGHT" VALIGN="BOTTOM" WIDTH="114"><FONT FACE="Menlo" POINT-SIZE="8" COLOR="#94a3b8">lemma:convex-words</FONT></TD></TR><HR/><TR><TD COLSPAN="2" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Avenir Next Demi-Bold" POINT-SIZE="15" COLOR="#0f172a">Words act on segments<BR/>through their endpoints</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Menlo" POINT-SIZE="10" COLOR="#1e40af">admissible_of_mem_segment<BR/>wordPerm_apply_of_mem_segment</FONT></TD></TR></TABLE>>];
    "lemma:words" [shape=box, style="rounded,filled", color="#1d4ed8", fillcolor="#ffffff", penwidth=1.4, margin="0.10,0.07", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#e2e8f0" WIDTH="214"><TR><TD ALIGN="LEFT" VALIGN="BOTTOM" WIDTH="100"><FONT FACE="Avenir Next Demi-Bold" POINT-SIZE="10" COLOR="#1d4ed8">LEMMA 2.3</FONT></TD><TD ALIGN="RIGHT" VALIGN="BOTTOM" WIDTH="114"><FONT FACE="Menlo" POINT-SIZE="8" COLOR="#94a3b8">lemma:words</FONT></TD></TR><HR/><TR><TD COLSPAN="2" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Avenir Next Demi-Bold" POINT-SIZE="15" COLOR="#0f172a">Three words translate the<BR/>three pieces</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Menlo" POINT-SIZE="10" COLOR="#1e40af">piece₁<BR/>piece₂<BR/>piece₃</FONT></TD></TR></TABLE>>];
    "lemma:rotation" [shape=box, style="rounded,filled", color="#1d4ed8", fillcolor="#ffffff", penwidth=1.4, margin="0.10,0.07", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#e2e8f0" WIDTH="214"><TR><TD ALIGN="LEFT" VALIGN="BOTTOM" WIDTH="100"><FONT FACE="Avenir Next Demi-Bold" POINT-SIZE="10" COLOR="#1d4ed8">LEMMA 2.4</FONT></TD><TD ALIGN="RIGHT" VALIGN="BOTTOM" WIDTH="114"><FONT FACE="Menlo" POINT-SIZE="8" COLOR="#94a3b8">lemma:rotation</FONT></TD></TR><HR/><TR><TD COLSPAN="2" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Avenir Next Demi-Bold" POINT-SIZE="15" COLOR="#0f172a">The exchange is a circle<BR/>rotation</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Menlo" POINT-SIZE="10" COLOR="#1e40af">chordRot<BR/>exists_mem_GG_apply_smul_chordE</FONT></TD></TR></TABLE>>];
    "thm:engine" [shape=box, style="rounded,filled", color="#1d4ed8", fillcolor="#ffffff", penwidth=2.8, margin="0.10,0.07", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#e2e8f0" WIDTH="214"><TR><TD ALIGN="LEFT" VALIGN="BOTTOM" WIDTH="100"><FONT FACE="Avenir Next Demi-Bold" POINT-SIZE="10" COLOR="#1d4ed8">THEOREM 2.5</FONT></TD><TD ALIGN="RIGHT" VALIGN="BOTTOM" WIDTH="114"><FONT FACE="Menlo" POINT-SIZE="8" COLOR="#94a3b8">thm:engine</FONT></TD></TR><HR/><TR><TD COLSPAN="2" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Avenir Next Demi-Bold" POINT-SIZE="15" COLOR="#0f172a">An irrational rotation<BR/>makes the group infinite</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Menlo" POINT-SIZE="10" COLOR="#1e40af">infinite_orbit_of_irrational_rotation<BR/>infinite_of_infinite_orbit</FONT></TD></TR></TABLE>>];
    "thm:upper" [shape=box, style="rounded,filled", color="#1d4ed8", fillcolor="#ffffff", penwidth=2.8, margin="0.10,0.07", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#e2e8f0" WIDTH="214"><TR><TD ALIGN="LEFT" VALIGN="BOTTOM" WIDTH="100"><FONT FACE="Avenir Next Demi-Bold" POINT-SIZE="10" COLOR="#1d4ed8">THEOREM 2.6</FONT></TD><TD ALIGN="RIGHT" VALIGN="BOTTOM" WIDTH="114"><FONT FACE="Menlo" POINT-SIZE="8" COLOR="#94a3b8">thm:upper</FONT></TD></TR><HR/><TR><TD COLSPAN="2" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Avenir Next Demi-Bold" POINT-SIZE="15" COLOR="#0f172a">The upper bound</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Menlo" POINT-SIZE="10" COLOR="#1e40af">infinite_orbit_zero<BR/>infinite_GG_five</FONT></TD></TR></TABLE>>];
  }
  subgraph "cluster_setup" {
    label=<<FONT FACE="Avenir Next Demi-Bold" POINT-SIZE="21" COLOR="#475569">Setup</FONT>>;
    labeljust="c"; labelloc="b";
    style="rounded,filled"; fillcolor="#f8fafc"; color="#cbd5e1"; penwidth=1.5;
    margin=20;
    "def:turns" [shape=box, style="filled", color="#64748b", fillcolor="#ffffff", penwidth=1.4, margin="0.10,0.07", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#e2e8f0" WIDTH="214"><TR><TD ALIGN="LEFT" VALIGN="BOTTOM" WIDTH="100"><FONT FACE="Avenir Next Demi-Bold" POINT-SIZE="10" COLOR="#475569">DEFINITION 1.1</FONT></TD><TD ALIGN="RIGHT" VALIGN="BOTTOM" WIDTH="114"><FONT FACE="Menlo" POINT-SIZE="8" COLOR="#94a3b8">def:turns</FONT></TD></TR><HR/><TR><TD COLSPAN="2" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Avenir Next Demi-Bold" POINT-SIZE="15" COLOR="#0f172a">The two turns</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Menlo" POINT-SIZE="10" COLOR="#475569">turn<BR/>genA<BR/>genB</FONT></TD></TR></TABLE>>];
    "def:group" [shape=box, style="filled", color="#64748b", fillcolor="#ffffff", penwidth=1.4, margin="0.10,0.07", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#e2e8f0" WIDTH="214"><TR><TD ALIGN="LEFT" VALIGN="BOTTOM" WIDTH="100"><FONT FACE="Avenir Next Demi-Bold" POINT-SIZE="10" COLOR="#475569">DEFINITION 1.2</FONT></TD><TD ALIGN="RIGHT" VALIGN="BOTTOM" WIDTH="114"><FONT FACE="Menlo" POINT-SIZE="8" COLOR="#94a3b8">def:group</FONT></TD></TR><HR/><TR><TD COLSPAN="2" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Avenir Next Demi-Bold" POINT-SIZE="15" COLOR="#0f172a">The group</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Menlo" POINT-SIZE="10" COLOR="#475569">GG</FONT></TD></TR></TABLE>>];
    "def:criticalRadius" [shape=box, style="filled", color="#64748b", fillcolor="#ffffff", penwidth=1.4, margin="0.10,0.07", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#e2e8f0" WIDTH="214"><TR><TD ALIGN="LEFT" VALIGN="BOTTOM" WIDTH="100"><FONT FACE="Avenir Next Demi-Bold" POINT-SIZE="10" COLOR="#475569">DEFINITION 1.3</FONT></TD><TD ALIGN="RIGHT" VALIGN="BOTTOM" WIDTH="114"><FONT FACE="Menlo" POINT-SIZE="8" COLOR="#94a3b8">def:criticalRadius</FONT></TD></TR><HR/><TR><TD COLSPAN="2" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Avenir Next Demi-Bold" POINT-SIZE="15" COLOR="#0f172a">The critical radius</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Menlo" POINT-SIZE="10" COLOR="#475569">criticalRadius</FONT></TD></TR></TABLE>>];
    "lemma:orbit-mono" [shape=box, style="rounded,filled", color="#64748b", fillcolor="#ffffff", penwidth=1.4, margin="0.10,0.07", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#e2e8f0" WIDTH="214"><TR><TD ALIGN="LEFT" VALIGN="BOTTOM" WIDTH="100"><FONT FACE="Avenir Next Demi-Bold" POINT-SIZE="10" COLOR="#475569">LEMMA 1.4</FONT></TD><TD ALIGN="RIGHT" VALIGN="BOTTOM" WIDTH="114"><FONT FACE="Menlo" POINT-SIZE="8" COLOR="#94a3b8">lemma:orbit-mono</FONT></TD></TR><HR/><TR><TD COLSPAN="2" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Avenir Next Demi-Bold" POINT-SIZE="15" COLOR="#0f172a">Orbits grow with the<BR/>radius</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Menlo" POINT-SIZE="10" COLOR="#475569">exists_mem_GG_apply_eq<BR/>orbit_subset_orbit_of_le</FONT></TD></TR></TABLE>>];
    "thm:T1" [shape=box, style="rounded,filled", color="#64748b", fillcolor="#ffffff", penwidth=2.8, margin="0.10,0.07", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#e2e8f0" WIDTH="214"><TR><TD ALIGN="LEFT" VALIGN="BOTTOM" WIDTH="100"><FONT FACE="Avenir Next Demi-Bold" POINT-SIZE="10" COLOR="#475569">THEOREM 1.5</FONT></TD><TD ALIGN="RIGHT" VALIGN="BOTTOM" WIDTH="114"><FONT FACE="Menlo" POINT-SIZE="8" COLOR="#94a3b8">thm:T1</FONT></TD></TR><HR/><TR><TD COLSPAN="2" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Avenir Next Demi-Bold" POINT-SIZE="15" COLOR="#0f172a">Bounded orbits imply a<BR/>finite group</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Menlo" POINT-SIZE="10" COLOR="#475569">finite_of_encard_orbit_le</FONT></TD></TR></TABLE>>];
    "lemma:finite-mono" [shape=box, style="rounded,filled", color="#64748b", fillcolor="#ffffff", penwidth=1.4, margin="0.10,0.07", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#e2e8f0" WIDTH="214"><TR><TD ALIGN="LEFT" VALIGN="BOTTOM" WIDTH="100"><FONT FACE="Avenir Next Demi-Bold" POINT-SIZE="10" COLOR="#475569">LEMMA 1.6</FONT></TD><TD ALIGN="RIGHT" VALIGN="BOTTOM" WIDTH="114"><FONT FACE="Menlo" POINT-SIZE="8" COLOR="#94a3b8">lemma:finite-mono</FONT></TD></TR><HR/><TR><TD COLSPAN="2" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Avenir Next Demi-Bold" POINT-SIZE="15" COLOR="#0f172a">Finiteness is monotone in<BR/>the radius</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Menlo" POINT-SIZE="10" COLOR="#475569">finite_GG_of_le</FONT></TD></TR></TABLE>>];
    "lemma:crit-upper" [shape=box, style="rounded,filled", color="#64748b", fillcolor="#ffffff", penwidth=1.4, margin="0.10,0.07", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#e2e8f0" WIDTH="214"><TR><TD ALIGN="LEFT" VALIGN="BOTTOM" WIDTH="100"><FONT FACE="Avenir Next Demi-Bold" POINT-SIZE="10" COLOR="#475569">LEMMA 1.7</FONT></TD><TD ALIGN="RIGHT" VALIGN="BOTTOM" WIDTH="114"><FONT FACE="Menlo" POINT-SIZE="8" COLOR="#94a3b8">lemma:crit-upper</FONT></TD></TR><HR/><TR><TD COLSPAN="2" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Avenir Next Demi-Bold" POINT-SIZE="15" COLOR="#0f172a">An infinite group bounds<BR/>the critical radius from<BR/>above</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Menlo" POINT-SIZE="10" COLOR="#475569">lt_of_finite_of_infinite</FONT></TD></TR></TABLE>>];
    "lemma:crit-lower" [shape=box, style="rounded,filled", color="#64748b", fillcolor="#ffffff", penwidth=1.4, margin="0.10,0.07", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#e2e8f0" WIDTH="214"><TR><TD ALIGN="LEFT" VALIGN="BOTTOM" WIDTH="100"><FONT FACE="Avenir Next Demi-Bold" POINT-SIZE="10" COLOR="#475569">LEMMA 1.8</FONT></TD><TD ALIGN="RIGHT" VALIGN="BOTTOM" WIDTH="114"><FONT FACE="Menlo" POINT-SIZE="8" COLOR="#94a3b8">lemma:crit-lower</FONT></TD></TR><HR/><TR><TD COLSPAN="2" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Avenir Next Demi-Bold" POINT-SIZE="15" COLOR="#0f172a">Finite groups below a<BR/>radius bound the critical<BR/>radius from below</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Menlo" POINT-SIZE="10" COLOR="#475569">le_criticalRadius_of_forall_lt</FONT></TD></TR></TABLE>>];
  }
  subgraph "cluster_lower-bound" {
    label=<<FONT FACE="Avenir Next Demi-Bold" POINT-SIZE="21" COLOR="#c2410c">Lower bound:  √(3 + φ) ≤ r<SUB><FONT POINT-SIZE="14">c</FONT></SUB>(5)</FONT>>;
    labeljust="r"; labelloc="b";
